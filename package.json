{
  "name": "otoge-db",
  "id": "otoge-db",
  "version": "1.0.0",
  "description": "Song information viewer for Ongeki",
  "keywords": [
    "ongeki",
    "chunithm",
    "maimai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zvuc/otoge-db"
  },
  "homepage": "https//otoge-db.net",
  "license": "MIT",
  "author": {
    "name": "Hansol Kim <i.am@hansol.kim>",
    "url": "https://xenosium.com"
  },
  "devDependencies": {
    "autoprefixer": "^9.8.0",
    "browser-sync": "^3.0.4",
    "cssnano": "^4.1.10",
    "esbuild": "^0.28.2",
    "imageoptim-cli": "^3.0.2",
    "less": "^3.11.1",
    "postcss": "^7.0.39",
    "pug": "^3.0.3"
  },
  "postcss": {
    "map": false,
    "plugins": {
      "autoprefixer": {},
      "cssnano": {}
    }
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "build:pug": "node scripts/build.js --pug",
    "build:less": "node scripts/build.js --less",
    "build:js": "node scripts/build.js --js",
    "imageoptim": "cat diffs.txt | xargs imageoptim",
    "fetch-songs": "./.venv/bin/python scripts/update-songs.py",
    "fetch-wiki": "./.venv/bin/python scripts/update-wiki-data.py",
    "fetch-chartguide": "./.venv/bin/python scripts/update-chartguide-data.py",
    "fetch-const": "./.venv/bin/python scripts/update-const.py",
    "fetch-intl": "./.venv/bin/python scripts/update-intl.py",
    "fetch-enemy-types": "./.venv/bin/python scripts/update-enemy-types.py",
    "clear-const": "./.venv/bin/python scripts/clear-const.py"
  },
  "packageManager": "yarn@3.6.0+sha512.418e45c2268c4d6b69a28f3939084b5853d5f392c43c0b5588bd1995a96e328414ae4b7777a8980c64bad4328c52586ff879b289f98ae65372a55fa4d0ff70dd"
}
